haversine_m <- function(lat1, lon1, lat2, lon2) {
R <- 6371000
phi1 <- lat1 * pi / 180
phi2 <- lat2 * pi / 180
dphi <- (lat2 - lat1) * pi / 180
dlam <- (lon2 - lon1) * pi / 180
a <- sin(dphi/2)^2 + cos(phi1) * cos(phi2) * sin(dlam/2)^2
R * 2 * atan2(sqrt(a), sqrt(1 - a))
}
N_CANDIDATES <- 1
N_CANDIDATES <- 10
candidates <- lapply(seq_len(nrow(rent_data)), function(i) {
lat_i <- rent_data$latitude[i]
lon_i <- rent_data$longitude[i]
dists <- haversine_m(lat_i, lon_i, bikemi$lat, bikemi$lon)
order(dists)[1:N_CANDIDATES]
})
