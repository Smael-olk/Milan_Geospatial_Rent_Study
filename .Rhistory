# 1. Load data
raw_path <- here("1 - Data Extraction", "final_dataset.csv")
rent_data <- read_csv(raw_path)
# 2. Clean 'Character' columns into 'Numeric'
# This handles "€ 500.00", "19 m²", etc.
clean_df <- rent_data %>%
mutate(
price_n   = as.numeric(str_extract(price_value, "[0-9.]+")),
surface_n = as.numeric(str_extract(surface, "[0-9.]+")),
rooms_n   = as.numeric(str_extract(rooms, "[0-9]+")),
# Calculate Price per Square Meter (The true 'Heat' metric)
price_sqm = price_n / surface_n
) %>%
# Remove rows with missing coordinates or zero prices
filter(!is.na(latitude), !is.na(longitude), price_n > 0) %>%
# Convert to Spatial Object (4326 is standard GPS)
st_as_sf(coords = c("longitude", "latitude"), crs = 4326)
View(rentals)
# 3. Quick ESDA Plot
# This will show you where the expensive areas are in Milan
mapview(clean_df, zcol = "price_sqm", layer.name = "Euro/m²")
View(clean_df)
View(clean_df)
# 3. Quick ESDA Plot
# This will show you where the expensive areas are in Milan
mapview(clean_df, zcol = "price_n", layer.name = "Euro")
# 3. Quick ESDA Plot
# This will show you where the expensive areas are in Milan
mapview(clean_df, zcol = "price_sqm", layer.name = "Euro/m²")
# Define the center of Milan (Duomo)
duomo <- st_sfc(st_point(c(9.1899, 45.4642)), crs = 4326) %>%
st_transform(32632) # Transform to meters
# Transform your data to meters too
rent_metric <- st_transform(clean_df, 32632)
# Calculate distance in kilometers
rent_metric$dist_to_cbd <- as.numeric(st_distance(rent_metric, duomo)) / 1000
# Plot the relationship
ggplot(rent_metric, aes(x = dist_to_cbd, y = price_sqm)) +
geom_point(alpha = 0.3, color = "steelblue") +
geom_smooth(method = "gam") +
labs(title = "Rent Decay: Price/m² vs Distance to Duomo",
x = "Distance (km)", y = "€ / m²")
library(spdep)
install.packages("spdep", type = "binary")")
install.packages("spdep", type = "binary")
# 1. Define neighbors (e.g., the 5 nearest neighbors for each apartment)
nb <- knn2nb(knearneigh(st_coordinates(rent_metric), k = 5))
library(spdep)
# 1. Define neighbors (e.g., the 5 nearest neighbors for each apartment)
nb <- knn2nb(knearneigh(st_coordinates(rent_metric), k = 5))
lw <- nb2listw(nb, style = "W")
# 2. Run Moran's I test on Price per sqm
moran.test(rent_metric$price_sqm, lw)
