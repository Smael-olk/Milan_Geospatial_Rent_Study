clean_df <- read_csv("./treated_surface.csv") %>% select(-c(title,features,address,surface_n))
library(sf)
library(tidyverse)
library(here)
library(mapview)
library(spdep)
library(ggplot2)
library(treemapify)
library(dplyr)
library(ggplot2)
library(gstat)
library(stars)
library(viridis)
library(writexl)
library(ggrepel) # Required for clear text labels
library(gstat)
# 1. Load data
# 1. Load data
# raw_path <- here("1 - Data Extraction", "final_dataset.csv")
clean_df <- read_csv("./treated_surface.csv") %>% select(-c(title,features,address,surface_n))
View(clean_df)
### 2. conversion to Spatial Object
rent_sf <- clean_df %>%
# 1. Drop rows with missing coordinates (sf will throw an error otherwise)
filter(!is.na(longitude) & !is.na(latitude)) %>%
# 2. Convert to a spatial object
# Note: coords are always ordered (X, Y) -> (Longitude, Latitude)
# CRS 4326 is the standard WGS84 GPS coordinate system
st_as_sf(coords = c("longitude", "latitude"), crs = 4326) %>%
# 3. Reproject for Kriging (Crucial Step!)
# CRS 32632 is UTM Zone 32N (The standard metric projection for Milan/Italy)
st_transform(crs = 32632)
rent_sf <- rent_sf %>%
st_jitter(amount = 0.2)
###### Testing for Autocorrelation : MicroScale : Jittering
# Step 1: Extract the geometric coordinates (in meters, thanks to EPSG:32632)
coords <- st_coordinates(rent_sf)
# Step 2: Define what a "Neighbor" is
# We use K-Nearest Neighbors (k=5 is a standard starting point for real estate)
# This ensures every room has exactly 5 neighbors to compare prices against
knn_neighbors <- knearneigh(coords, k = 5)
nb <- knn2nb(knn_neighbors)
# Step 3: Create a Spatial Weights Matrix
# style = "W" creates row-standardized weights (each neighbor gets equal 1/5th weight)
listw <- nb2listw(nb, style = "W")
# Step 4: Run the Moran's I Test on your target variable (e.g., price_sqm)
moran.test(rent_sf$price_sqm, listw)
