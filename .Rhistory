# Plot of the box cox transformation applied to the uniform sequence
{
box_cox <- function(x, lambda) {
if (lambda != 0)
return((x ^ lambda - 1) / lambda)
return(log(x))
}
x <- seq(0, 25, by = 0.01)
# Plot of the box cox transformation applied to the uniform sequence
par(mfrow = c(1, 1))
plot(
box_cox(x, 0),
type = 'l',
ylab = expression(x[lambda]),
xlim = c(-5, 25),
# apply box cox on surface to have a more normal distribution
