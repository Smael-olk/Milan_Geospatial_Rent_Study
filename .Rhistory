library(sf)
library(mapview)
library(tidyverse)
library(here)
# Load from your specific folder structure
rentals <- read_csv(here("1 - Data Extraction", "final_dataset.csv")) %>%
mutate(
price_num = as.numeric(str_extract(price_value, "[0-9.]+")),
